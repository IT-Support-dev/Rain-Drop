<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RainDrop.Master</AssemblyName>
    <RootNamespace>RainDrop.Master</RootNamespace>
    <ApplicationIcon>..\assets\raindrop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI (ProtectedData) เข้ารหัสกุญแจลับของ Master ผูกกับบัญชี Windows ปัจจุบัน -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ให้เทสต์เรียก KeyVault ที่เป็น internal ได้ ไม่เปลี่ยนเป็น public -->
    <InternalsVisibleTo Include="RainDrop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\raindrop.ico" Link="raindrop.ico" />
  </ItemGroup>

</Project>
