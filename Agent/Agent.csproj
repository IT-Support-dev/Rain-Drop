<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RainDrop.Agent</AssemblyName>
    <RootNamespace>RainDrop.Agent</RootNamespace>
    <ApplicationIcon>..\assets\raindrop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- เปิดให้โปรเจกต์เทสต์เรียกชนิดและเมธอดภายในได้ โดยไม่ต้องเปลี่ยน access modifier เป็น public -->
    <InternalsVisibleTo Include="RainDrop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ฝังไอคอนไว้ในโปรแกรม เพื่อโหลดใช้กับ NotifyIcon ได้โดยไม่ต้องมีไฟล์ .ico แยก -->
    <EmbeddedResource Include="..\assets\raindrop.ico" Link="raindrop.ico" />
  </ItemGroup>

</Project>
