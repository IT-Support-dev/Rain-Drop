    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <AssemblyName>RainDrop.AgentService</AssemblyName>
    <RootNamespace>RainDrop.AgentService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ให้เทสต์เรียก HostsBlocker.ToHost/BuildBlock ที่เป็น internal ได้ ไม่เปลี่ยนเป็น public -->
    <InternalsVisibleTo Include="RainDrop.Tests" />
  </ItemGroup>

</Project>
